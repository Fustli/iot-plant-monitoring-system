# IoT Plant Monitoring System - Development Environment Configuration
# THIS FILE SHOULD NOT BE COMMITTED TO VERSION CONTROL
# Copy from .env.example and modify as needed

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=iot_plant_db
POSTGRES_DB_USER=iot_user
POSTGRES_DB_PASSWORD=iot_password

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ============================================================================
# EXTERNAL APIs
# ============================================================================

# Trefle Plant API (https://trefle.io/)
TREFLE_API_KEY=uRAAAAAAAAAAAAAAAAAa

# ============================================================================
# SERVER CONFIGURATION (ServerModule)
# ============================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_WORKERS=1

# ============================================================================
# MQTT CONFIGURATION (IoT Device Communication)
# ============================================================================

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=
MQTT_KEEP_ALIVE=60

MQTT_TOPIC_PREFIX=iot/plants
MQTT_DEVICE_TOPIC=iot/plants/devices
MQTT_SENSOR_TOPIC=iot/plants/sensors
MQTT_CONTROL_TOPIC=iot/plants/control

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

API_KEY=dev-api-key-change-in-production

# ============================================================================
# BACKEND SERVICES
# ============================================================================

EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@iotplantmonitoring.local
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

NOTIFICATIONS_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=false

# ============================================================================
# DEVICE & SENSOR SETTINGS
# ============================================================================

DEVICE_POLL_INTERVAL=30
SENSOR_DATA_RETENTION_DAYS=365
ALERT_CHECK_INTERVAL=60

# ============================================================================
# DEVELOPMENT/TESTING SETTINGS
# ============================================================================

TEST_DATABASE_URL=postgresql://iot_user:iot_password@localhost:5432/iot_plant_db_test
MOCK_DEVICES_ENABLED=true
DOCS_ENABLED=true
DOCS_URL=/api/docs

# ============================================================================
# DOCKER/CONTAINER SETTINGS
# ============================================================================

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# FLUTTER SDK CONFIGURATION
# ============================================================================

# Path to your Flutter SDK executable
# Uncomment and modify if Flutter is installed in a different location
# FLUTTER_CMD=/path/to/your/flutter/bin/flutter
FLUTTER_CMD=/opt/flutter/bin/flutter
# or wherever your Flutter is installed