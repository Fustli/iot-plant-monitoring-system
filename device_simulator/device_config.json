{
  "broker": "localhost",
  "port": 1883,
  "publish_topic": "telemetry",
  "command_topic": "actuators/device1/set",
  "device_id": "device1",
  "interval": 30,
  "sensors": {
    "temperature": {
      "value": 25.0, 
      "unit": "C"
      }, 
      "moisture": {
        "value": 40,
        "unit": "%"
      }
  },
  "actuators": ["moisture", "light"]
}
